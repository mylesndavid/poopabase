{
  "name": "poopabase",
  "version": "0.1.0",
  "description": "The database for agents",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poopabase/poopabase.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:platform": "npm run build -w @poopabase/web && npm run build -w @poopabase/platform",
    "dev:dashboard": "npm run dev -w @poopabase/dashboard",
    "dev:platform": "npm run dev -w @poopabase/platform",
    "dev:web": "npm run dev -w @poopabase/web",
    "platform": "concurrently -n api,web -c magenta,cyan \"npm run dev:platform\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
